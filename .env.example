# bbt (big brain time) - Environment Configuration Template
# Copy this file to .env and customize for your environment

# General Settings
LOG_LEVEL=info
BBT_DATA_DIR=./data
BBT_MODEL_CACHE_DIR=./.cache/models

# Document Processing
BBT_CHUNK_SIZE=512
BBT_CHUNK_OVERLAP=128
BBT_MAX_FILE_SIZE_BYTES=10485760  # 10 MiB
BBT_ENABLE_OCR=false
BBT_ENABLE_SECTION_DETECTION=true
BBT_MIN_HEADING_FONT_SIZE=10.0
BBT_HEADING_THRESHOLD_RATIO=1.2

# Embedding Configuration
# default: jinaai/jina-embeddings-v2-base-code (768 dims, 8192 token context, code-optimized)
BBT_EMBEDDING_MODEL_REPO=jinaai/jina-embeddings-v2-base-code
BBT_EMBEDDING_MODEL_FILE=onnx/model.onnx
BBT_EMBEDDING_BATCH_SIZE=32
BBT_EMBEDDING_DIMS=768

# legacy: BAAI/bge-small-en-v1.5 (384 dims, 512 token context)
# BBT_EMBEDDING_MODEL_REPO=BAAI/bge-small-en-v1.5
# BBT_EMBEDDING_MODEL_FILE=onnx/model.onnx
# BBT_EMBEDDING_BATCH_SIZE=32
# BBT_EMBEDDING_DIMS=384

# nvidia nemotron (4096 dims, requires onnx export - see scripts/export_nemotron_onnx.py)
# BBT_EMBEDDING_MODEL_REPO=nvidia/llama-embed-nemotron-8b
# BBT_EMBEDDING_MODEL_FILE=onnx/model.onnx
# BBT_EMBEDDING_BATCH_SIZE=16
# BBT_EMBEDDING_DIMS=4096

# Retrieval Settings
BBT_RETRIEVAL_MODE=hybrid
BBT_TOP_K=20
BBT_VECTOR_WEIGHT=0.7
BBT_BM25_WEIGHT=0.3
BBT_ENABLE_RERANK=false

# Vector Store (Qdrant)
BBT_VECTOR_STORE_TYPE=qdrant
BBT_VECTOR_STORE_URL=http://localhost:6333
BBT_VECTOR_STORE_COLLECTION=documents

# BM25 Index
BBT_BM25_INDEX_PATH=./data/bm25_index.jsonl
BBT_BM25_K1=1.5
BBT_BM25_B=0.75

# State Store
BBT_STATE_STORE_PATH=./data/state_store.json

# Server Settings
BBT_SERVER_HOST=0.0.0.0
BBT_SERVER_PORT=8080
BBT_SERVER_CORS=false
BBT_SERVER_API_KEY=

# GPU Acceleration
# BBT_FORCE_CPU=1  # uncomment to disable gpu

# Tracing/Observability
BBT_ENABLE_TRACING=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317

# LLM Schema Generation
BBT_SCHEMA_REPO_ID=unsloth/Llama-3.1-Nemotron-Nano-8B-v1-GGUF
BBT_SCHEMA_FILENAME=Llama-3.1-Nemotron-Nano-8B-v1-Q4_K_M.gguf
BBT_SCHEMA_MAX_RETRIES=3

# Langfuse (Optional - for advanced tracing)
# LANGFUSE_PUBLIC_KEY=lf-local-dev-public-key
# LANGFUSE_SECRET_KEY=lf-local-dev-secret-key
# LANGFUSE_HOST=http://localhost:3000
